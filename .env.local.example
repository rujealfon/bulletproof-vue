# Local Development Overrides
# Copy this file to .env.local and customize for your local environment

# Override API URL for local development
VITE_API_URL=http://localhost:3001

# Enable mock API for local development
VITE_MOCK_API=true

# Development logging
VITE_LOG_LEVEL=debug

# Enable all development tools
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MSW=true

# Local authentication (mock provider)
VITE_AUTH_PROVIDER=mock

# Disable analytics in local development
VITE_ENABLE_ANALYTICS=false

# Enable source maps for debugging
VITE_BUILD_SOURCEMAP=true